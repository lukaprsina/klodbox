{
    "name": "klodbox",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "mounts": [
        "source=claude-code-config,target=/home/vscode/.claude,type=volume",
        "source=gh-config,target=/home/vscode/.config/gh,type=volume",
        "source=cargo-home,target=/home/vscode/.cargo,type=volume",
        "source=rustup-home,target=/home/vscode/.rustup,type=volume",
        "source=shell-history-${devcontainerId},target=/commandhistory,type=volume"
    ],
    "postCreateCommand": "bash .devcontainer/install.sh"
}
