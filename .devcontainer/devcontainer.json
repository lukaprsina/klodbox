{
    "name": "klodbox",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    "init": true,
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "mounts": [
        "source=claude-code-config,target=/home/vscode/.claude,type=volume",
        "source=gh-config,target=/home/vscode/.config/gh,type=volume",
        "source=kache-cache,target=/home/vscode/.cache/kache,type=volume",
        "source=cargo-registry,target=/home/vscode/.cargo/registry,type=volume",
        "source=cargo-git,target=/home/vscode/.cargo/git,type=volume",
        "source=shell-history-${devcontainerId},target=/commandhistory,type=volume"
    ],
    "postCreateCommand": "bash .devcontainer/install.sh"
}